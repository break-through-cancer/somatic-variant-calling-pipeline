params {
    max_memory                = 488.GB
    max_cpus                  = 64
    max_time                  = 240.h
}

process {
    executor = 'awsbatch'
    errorStrategy = 'retry'
    maxRetries = 5

    // Resource limits (Nextflow 24.x+)
    resourceLimits = [ cpus: params.max_cpus, memory: params.max_memory, time: params.max_time ]

    // ---- MuTect1 (from the standalone mutect-1 pipeline) -------------------------------
    withName: SPLIT_INTERVALS {
        errorStrategy = 'terminate'
        maxRetries = 4
        cpus = 2
        memory = { 8.GB * task.attempt }
    }
    withName: INDEX_CONTEST_VCF {
        errorStrategy = 'terminate'
        maxRetries = 4
        cpus = 2
        memory = { 8.GB * task.attempt }
    }
    withName: MUTECT1 {
        errorStrategy = 'retry'
        maxRetries = 3
        queue = env('PW_ONDEMAND_JOB_QUEUE')
        cpus = 2
        memory = { 16.GB * task.attempt }
        maxForks = 100
    }
    withName: CONTEST {
        errorStrategy = 'terminate'
        maxRetries = 3
        queue = env('PW_ONDEMAND_JOB_QUEUE')
        cpus = 2
        memory = { 16.GB * task.attempt }
    }
    withName: GATHER_AND_FILTER {
        errorStrategy = 'terminate'
        maxRetries = 2
        cpus = 2
        memory = { 8.GB * task.attempt }
    }

    // ---- DeepSomatic GPU process (from the standalone deepsomatic pipeline) ------------
    // Parabricks DeepSomatic requires a GPU and substantial resources for WGS.
    // Uses the OnDemand queue for consistent availability (Spot can queue 1-3h+ for 4-GPU capacity).
    withName: DEEPSOMATIC {
        accelerator   = 1
        // Starts at the resources that completed a WGS sample (16 CPUs / 120 GB, peak RSS ~74 GB)
        // and grows on each retry. AWS Batch reports an OOM-killed container as exit 255
        // (not 137), so 255 must be in the retry list below for the memory to scale up.
        cpus          = { 16 * task.attempt }
        memory        = { 120.GB * task.attempt }
        queue         = env('PW_ONDEMAND_JOB_QUEUE')
        errorStrategy = { task.exitStatus in ((130..145) + 104 + 255 + (175..177) + 2147483647) ? 'retry' : 'finish' }
        maxRetries    = 2
    }

    // ---- Manta / Strelka ----------------------------------------------------------------
    // Both run locally inside the task on all its CPUs. Starting values are a WGS
    // tumor/normal pair; memory grows on retry (exit 137 = OOM kill, 255 = AWS Batch OOM).
    // NOTE: not yet tuned on real data -- adjust after the first runs.
    withName: BED_TABIX {
        cpus   = 1
        memory = { 4.GB * task.attempt }
    }
    withName: MANTA_SOMATIC {
        cpus          = 16
        memory        = { 48.GB * task.attempt }
        errorStrategy = { task.exitStatus in ((130..145) + 104 + 255) ? 'retry' : 'finish' }
        maxRetries    = 2
    }
    withName: STRELKA_SOMATIC {
        cpus          = 16
        memory        = { 48.GB * task.attempt }
        errorStrategy = { task.exitStatus in ((130..145) + 104 + 255) ? 'retry' : 'finish' }
        maxRetries    = 2
    }

    // ---- Consensus (from the standalone consensus-calling pipeline) ---------------------
    withName: CONSENSUS {
        errorStrategy = 'retry'
        maxRetries = 2
        cpus = 2
        memory = { 16.GB * task.attempt }
    }
}

aws {
    region = 'us-east-1'
    batch {
        // GPU instance for DeepSomatic. Options:
        //   't4' ~$0.35/hr (4-6h WGS), 'a10' ~$1.76/hr (2-3h WGS, balanced), 'h100' ~$4.77/hr (30-60min)
        instanceTypes = ['a10']
    }
}

docker {
    registry = 'quay.io'
    enabled  = true
}

apptainer {
    registry = 'quay.io'
    enabled  = false
}
