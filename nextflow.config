nextflow.enable.dsl = 2

params {
    outdir                    = 'results'

    // Set by .cirro/preprocess.py from the input dataset
    runs                      = null     // [{sample_name, tumor_bam, tumor_bam_index}, ...]
    normal_sample_name        = null
    normal_bam                = null
    normal_bam_index          = null
    callers                   = 'mutect,deepsomatic,strelka'

    // Consensus across the selected callers (needs at least two)
    run_consensus             = true
    // Keep only PASS (and '.') records from each caller before the consensus. DeepSomatic
    // VCFs contain non-PASS records (e.g. RefCall) that would otherwise count as support.
    pass_only                 = true

    // References
    ref                       = 'hg38'   // genome name used by the MuTect1 interval splitter
    ref_fasta                 = null
    ref_fai                   = null
    ref_dict                  = null

    // Manta / Strelka
    call_regions              = null     // BED restricting Manta/Strelka (e.g. WGS calling regions)
    wes                       = false    // targeted data: adds --exome to Manta/Strelka

    // DeepSomatic
    num_streams_per_gpu       = 1
    enable_gvcf               = false

    // MuTect1
    scatter_count             = 200
    padding_bp                = 100
    target_list               = null
    force_calling_intervals   = null
    force_calling             = false
    exclude_chimeric          = false
    downsample                = 99999
    max_mismatch_baseq_sum    = 100
    fracContam                = 0.01
    // ContEst
    contest_target_intervals  = null
    snp6_bed                  = null
    hapmap_vcf                = null
    // Optional MuTect1 resources
    dbsnp                     = null
    dbsnp_idx                 = null
    cosmic                    = null
    cosmic_idx                = null
    read_group_blacklist      = null
    normal_panel              = null
    normal_panel_idx          = null
}

process {
    executor      = 'local'
    errorStrategy = 'retry'
    maxRetries    = 2
}

docker {
    enabled  = true
    registry = 'quay.io'
}

apptainer {
    enabled  = false
    registry = 'quay.io'
}

profiles {
    awsbatch {
        process {
            executor = 'awsbatch'
            queue    = 'default'
        }
        aws {
            region = 'us-east-1'
        }
    }
}
